# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://armageddontest.icu

# Playwright E2E admin credentials (e2e/initiate-sequence.spec.ts, e2e/admin-bypass.spec.ts).
# Leave empty to skip those specs. Never commit real values.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
